<Layouts.flash_group flash={@flash} />

<main class="min-h-screen bg-base-100 px-6 py-10 text-base-content lg:px-12">
  <section class="mx-auto max-w-7xl space-y-10">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.3em] text-primary">
          Incant Playground
        </p>
        <h1 class="mt-3 text-4xl font-semibold tracking-tight lg:text-6xl">
          Metadata-first admin experiments
        </h1>
        <p class="mt-4 max-w-3xl text-lg text-base-content/70">
          This Phoenix playground consumes the local Incant package and defines resources,
          dashboards, and a Tailwind/CSS-variable theme that future renderers can turn into a
          production LiveView control plane.
        </p>
      </div>
      <div class="flex items-center gap-3">
        <.link navigate={~p"/admin"} class="btn btn-primary">Open admin</.link>
        <Layouts.theme_toggle />
      </div>
    </div>

    <div class="grid gap-4 md:grid-cols-3">
      <div class="rounded-box border border-base-300 bg-base-200 p-5">
        <div class="text-sm text-base-content/60">Resources</div>
        <div class="mt-2 text-3xl font-semibold">{length(@resources)}</div>
      </div>
      <div class="rounded-box border border-base-300 bg-base-200 p-5">
        <div class="text-sm text-base-content/60">Dashboards</div>
        <div class="mt-2 text-3xl font-semibold">{length(@dashboards)}</div>
      </div>
      <div class="rounded-box border border-base-300 bg-base-200 p-5">
        <div class="text-sm text-base-content/60">Theme prefix</div>
        <div class="mt-2 font-mono text-lg">{@theme.css_vars_prefix}</div>
      </div>
    </div>

    <section class="space-y-4">
      <h2 class="text-2xl font-semibold">Resources</h2>
      <div class="grid gap-4 lg:grid-cols-2">
        <article
          :for={resource <- @resources}
          class="rounded-box border border-base-300 bg-base-200 p-5"
        >
          <div class="flex items-start justify-between gap-4">
            <div>
              <h3 class="font-mono text-lg font-semibold">{inspect(resource.module)}</h3>
              <p class="mt-1 text-sm text-base-content/60">Schema: {inspect(resource.schema)}</p>
            </div>
            <span class="badge badge-primary">{length(resource.table.columns)} columns</span>
          </div>

          <div class="mt-5 overflow-hidden rounded-box border border-base-300">
            <table class="table table-sm">
              <thead>
                <tr>
                  <th>Column</th>
                  <th>Options</th>
                </tr>
              </thead>
              <tbody>
                <tr :for={column <- resource.table.columns}>
                  <td class="font-mono">{column.name}</td>
                  <td class="font-mono text-xs text-base-content/70">{inspect(column.opts)}</td>
                </tr>
              </tbody>
            </table>
          </div>

          <div class="mt-4 flex flex-wrap gap-2">
            <span :for={filter <- resource.table.filters} class="badge badge-outline">
              {filter.name}: {filter.type}
            </span>
          </div>
        </article>
      </div>
    </section>

    <section class="space-y-4">
      <h2 class="text-2xl font-semibold">Dashboards</h2>
      <article
        :for={dashboard <- @dashboards}
        class="rounded-box border border-base-300 bg-base-200 p-5"
      >
        <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
          <h3 class="text-xl font-semibold">{dashboard.title}</h3>
          <span class="font-mono text-sm text-base-content/60">{inspect(dashboard.grid)}</span>
        </div>

        <div class="mt-4 flex flex-wrap gap-2">
          <span :for={variable <- dashboard.variables} class="badge badge-secondary">
            var {variable.name}: {variable.type}
          </span>
        </div>

        <div class="mt-5 grid gap-3 md:grid-cols-2 lg:grid-cols-3">
          <div :for={widget <- dashboard.widgets} class="rounded-box bg-base-100 p-4 shadow-sm">
            <div class="text-sm text-base-content/60">{widget.type}</div>
            <div class="mt-1 font-mono font-semibold">{widget.id}</div>
            <div class="mt-2 font-mono text-xs text-base-content/60">{inspect(widget.opts)}</div>
          </div>
        </div>
      </article>
    </section>

    <section class="space-y-4">
      <h2 class="text-2xl font-semibold">Theme contract</h2>
      <div class="rounded-box border border-base-300 bg-base-200 p-5">
        <div class="grid gap-4 md:grid-cols-2">
          <div>
            <h3 class="font-semibold">Tokens</h3>
            <ul class="mt-3 space-y-2 font-mono text-sm">
              <li :for={{kind, name, value} <- @theme.tokens}>
                {kind}.{name} = {value}
              </li>
            </ul>
          </div>
          <div>
            <h3 class="font-semibold">Tables and charts</h3>
            <pre class="mt-3 whitespace-pre-wrap rounded-box bg-base-100 p-4 text-xs"><%= inspect(%{table: @theme.table, charts: @theme.charts}, pretty: true) %></pre>
          </div>
        </div>
      </div>
    </section>
  </section>
</main>
